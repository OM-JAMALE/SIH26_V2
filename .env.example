# .env.example - AI Provider Configuration Examples

# ============================================
# Environment Setup
# ============================================

APP_ENV=development
APP_NAME="Healthcare AI Pre-consultation Platform"

# ============================================
# Database Configuration
# ============================================

DATABASE_URL=sqlite:///./health_ai.db
# DATABASE_URL=postgresql://user:password@localhost/health_ai
# DATABASE_URL=mysql+pymysql://user:password@localhost/health_ai

# ============================================
# AI PROVIDER ABSTRACTION LAYER
# ============================================

# Provider Selection
# Options: mock, openai, gemini, local, ollama
# - mock: Deterministic responses (no API calls, best for testing)
# - openai: Production grade with ChatGPT-4 (requires API key)
# - gemini: Google's LLM (requires API key)
# - local/ollama: On-premise LLM via Ollama (requires Docker)
AI_PROVIDER=mock

# ============================================
# OpenAI Configuration (Production)
# ============================================

# Get API key from: https://platform.openai.com/api-keys
# DO NOT commit actual key to version control
OPENAI_API_KEY=sk-your-api-key-here

# Model options:
# - gpt-4-turbo-preview (recommended)
# - gpt-4
# - gpt-3.5-turbo
OPENAI_MODEL=gpt-4-turbo-preview

# ============================================
# Google Gemini Configuration (Alternative)
# ============================================

# Get API key from Google Cloud Console
GEMINI_API_KEY=your-gemini-api-key-here

# ============================================
# Local Ollama Configuration (On-Premise)
# ============================================

# Base URL for Ollama API
# Default: http://localhost:11434
# Format: http://[host]:[port]
OLLAMA_BASE_URL=http://localhost:11434

# Model to use with Ollama
# Available models: qwen3, llama2, mistral, neural-chat, etc.
# Install models with: ollama pull [model-name]
OLLAMA_MODEL=qwen3

# ============================================
# File Upload Configuration
# ============================================

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=26214400  # 25 MB

# ============================================
# Security
# ============================================

SECRET_KEY=your-secret-key-change-in-production

# ============================================
# CORS Configuration
# ============================================

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ============================================
# Redis (Optional)
# ============================================

REDIS_URL=redis://localhost:6379/0

# ============================================
# Logging
# ============================================

LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================
# Examples
# ============================================

# EXAMPLE 1: Development with Mock Provider (DEFAULT)
# AI_PROVIDER=mock
# No external dependencies, tests run immediately

# EXAMPLE 2: Local Development with Ollama
# AI_PROVIDER=local
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3
# Requires: docker run -d -p 11434:11434 ollama/ollama

# EXAMPLE 3: Production with OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4-turbo-preview
# Requires: pip install openai

# EXAMPLE 4: Testing with Gemini
# AI_PROVIDER=gemini
# GEMINI_API_KEY=...
# Requires: pip install google-genai
