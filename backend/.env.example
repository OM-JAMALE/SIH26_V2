# Healthcare AI Platform Environment Configuration
# Copy this file to backend/.env and fill in your API keys

# 1. AI Provider Selection
# Options: "mock" (default, free offline), "openai", "gemini", "local"
AI_PROVIDER=openai

# 2. OpenAI Configuration (if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-your-actual-openai-api-key-here

# 3. Google Gemini Configuration (if AI_PROVIDER=gemini)
GEMINI_API_KEY=AIzaSy-your-actual-gemini-api-key-here

# 4. Local Ollama LLM Configuration (if AI_PROVIDER=local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3

# 5. Database & Server Configuration
DATABASE_URL=sqlite:///./health_ai.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=super-secret-key-change-in-production
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
LOG_LEVEL=INFO
